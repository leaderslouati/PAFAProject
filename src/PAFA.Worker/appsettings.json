{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=pafadb;Username=postgres;Password=postgres"
  },
  "BlobStorage": {
    "Provider": "MinIO",
    "LocalPath": "./storage",
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UseSsl": false,
    "BaseBucket": "pafa"
  },
  "SharePoint": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "SiteUrl": "",
    "SiteId": "",
    "DriveId": "",
    "BaseInboundPath": "",
    "ProcessedPath": "/Processed",
    "FailedPath": "/Failed",
    "FilePattern": "*.xlsx",
    "AllowedFilePrefixesList": [
      "MOD520A", "RPT_1364", "Rpt_1364", "MOD700", "EUC09", "TRANSFER", "CLASS4AQ",
      "Read Performance by Shipper",
      "Shipper Transfer Read Performance",
      "Supply Points and AQ with Minimum Percentage Not met",
      "Supply Points with Minimum Percentage Requirement",
      "Report 1 - Percentage MPRN removed from Must Read",
      "Report 1A",
      "Report 1B",
      "Report 2 - Percentage MPRN removed from Must Read age bucket",
      "Report 2 - Proportion of sites set as Vacant",
      "Report 3 - Count MPRN",
      "Class 3 conversion",
      "Confirmed Energy Theft Claim objections_P106",
      "Confirmed Energy Theft Claim objections_P41",
      "Confirmed Energy Theft Withdrawal objections_P106",
      "Confirmed Energy Theft Withdrawal objections_P41",
      "202",
      "2B.21 Corrective Opening Meter Reading Rejections",
      "AQ at Risk"
    ],
    "AllowedExtensionsList": [ ".xlsx", ".xls", ".csv", ".xml" ],
    "EnforceYearMonthFolderStructure": true
  },
  "Jwt": {
    "Key": "PAFA_DEFAULT_DEV_KEY_CHANGE_IN_PRODUCTION_32CH",
    "Issuer": "pafa-api",
    "Audience": "pafa-client"
  },
  "ServiceBus": {
    "ConnectionString": "",
    "ValidationFailureTopic": "pafa-validation-failure",
    "IngestionFailureTopic": "pafa-ingestion-failure",
    "WelcomeTopic": "pafa-user-welcome"
  },
  "Notifications": {
    "ValidationFailureRecipients": [],
    "IngestionFailureRecipients": []
  },
  "PowerBiBatchExport": {
    "IsEnabled": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  }
}
