{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=pafadb;Username=postgres;Password=postgres"
  },
  "IngestionSchedule": {
    "CronWindowStartDay": 18,
    "CronWindowEndDay": 21,
    "CronExpression": "0 2 18-21 * *",
    "TimeZone": "UTC"
  },
  "BlobStorage": {
    "Provider": "MinIO",
    "LocalPath": "./storage",
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UseSsl": false
  },
  "SharePoint": {
    "TenantId": "<GUID-tenant-azure-ad>",
    "ClientId": "<GUID-app-registration>",
    "ClientSecret": "",
    "SiteUrl": "https://talan0.sharepoint.com/sites/PAFA-POC",
    "SiteId": "<talan0.sharepoint.com,siteId,webId>",
    "DriveId": "",
    "BaseInboundPath": "",
    "ProcessedPath": "/Processed",
    "FailedPath": "/Failed",
    "FilePattern": "*.xlsx",
    "AllowedFilePrefixesList": [
      "MOD520A", "RPT_1364", "Rpt_1364", "MOD700", "EUC09", "TRANSFER", "CLASS4AQ",
      "Read Performance by Shipper",
      "Shipper Transfer Read Performance",
      "Supply Points and AQ with Minimum Percentage Not met",
      "Supply Points with Minimum Percentage Requirement",
      "Report 1 - Percentage MPRN removed from Must Read",
      "Report 1A",
      "Report 1B",
      "Report 2 - Percentage MPRN removed from Must Read age bucket",
      "Report 2 - Proportion of sites set as Vacant",
      "Report 3 - Count MPRN",
      "Class 3 conversion",
      "Confirmed Energy Theft Claim objections_P106",
      "Confirmed Energy Theft Claim objections_P41",
      "Confirmed Energy Theft Withdrawal objections_P106",
      "Confirmed Energy Theft Withdrawal objections_P41",
      "202",
      "2B.21 Corrective Opening Meter Reading Rejections",
      "AQ at Risk"
    ],
    "AllowedExtensionsList": [ ".xlsx", ".xls", ".csv", ".xml" ],
    "EnforceYearMonthFolderStructure": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  },
  "Jwt": {
    "Key": "PAFA_DEFAULT_DEV_KEY_CHANGE_IN_PRODUCTION_32CH",
    "Issuer": "pafa-api",
    "Audience": "pafa-client"
  },
  "PowerBi": {
    "TenantId": "<AZURE_AD_TENANT_ID>",
    "ClientId": "<APP_REGISTRATION_CLIENT_ID>",
    "ClientSecret": "",
    "WorkspaceId": "<POWER_BI_WORKSPACE_GUID>",
    "AnonymizedReportId": "<REPORT_ID_SCHEDULE_2A>",
    "AnonymizedDatasetId": "<DATASET_ID_SCHEDULE_2A>",
    "NonAnonymizedReportId": "<REPORT_ID_SCHEDULE_2B>",
    "NonAnonymizedDatasetId": "<DATASET_ID_SCHEDULE_2B>",
    "ExportTimeoutSeconds": 300,
    "ExportPollIntervalSeconds": 5
  },

  "PowerBiBatchExport": {
    "IsEnabled": false,
    "BatchSize": 5,
    "ThrottleDelaySeconds": 10,
    "BlobContainer": "reports",
    "DatasetRefreshTimeoutMinutes": 10,
    "RefreshPollIntervalSeconds": 15,
    "ExportTimeoutSeconds": 300,
    "ExportPollIntervalSeconds": 5,

    "Datasets": [
      {
        "DatasetId": "<DATASET_ID_SCHEDULE_2A_IMPORT>",
        "Label": "Schedule 2A — Industry (Import)",
        "RequiresRefresh": true
      },
      {
        "DatasetId": "<DATASET_ID_SCHEDULE_2B_IMPORT>",
        "Label": "Schedule 2B — PAC (Import)",
        "RequiresRefresh": true
      }
    ],

    "Reports": [
