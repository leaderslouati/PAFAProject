    <DataSet Name="DS_Density_PC1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH TargetMonths AS (
    -- 1. On identifie le mois le plus récent (ex: 2026-04)
    -- 2. On calcule le même mois l'année précédente (ex: 2025-04)
    SELECT TO_CHAR(CAST(MAX(report_month) || '-01' AS DATE), 'YYYY-MM') as m_key
    FROM public.v_parr_industry
    UNION ALL
    SELECT TO_CHAR(CAST(MAX(report_month) || '-01' AS DATE) - INTERVAL '1 year', 'YYYY-MM')
    FROM public.v_parr_industry
),
RawData AS (
    SELECT shipper_code, report_month, estimated_pct 
    FROM public.v_parr_industry
    WHERE product_class = 'PC1' -- N'oubliez pas de mettre PC2 pour le deuxième graphe
    AND report_month IN (SELECT m_key FROM TargetMonths)
),
BinnedData AS (
    SELECT 
        report_month,
        (ROUND(CAST(estimated_pct AS numeric) / 2.0) * 2.0) / 100.0 as pct_bin,
        COUNT(DISTINCT shipper_code) as density_count
    FROM RawData
    GROUP BY report_month, ROUND(CAST(estimated_pct AS numeric) / 2.0) * 2.0
)
SELECT 
    d.month_year as month_label, -- Récupère le format 'Apr-26' et 'Apr-25'
    b.pct_bin, 
    b.density_count
FROM BinnedData b
JOIN public.vw_dim_date d ON b.report_month = d.date_key
ORDER BY b.report_month ASC, b.pct_bin ASC;</CommandText>
      </Query>
      <Fields>
        <Field Name="month_label">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>month_label</DataField>
        </Field>
        <Field Name="pct_bin">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>pct_bin</DataField>
        </Field>
        <Field Name="density_count">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>density_count</DataField>
        </Field>
      </Fields>
    </DataSet>
