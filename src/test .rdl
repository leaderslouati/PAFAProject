  <DataSets>
    <DataSet Name="MonthlyAverages">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>WITH MonthlyAverages AS (
    -- On calcule d'abord la moyenne par mois et par shipper
    SELECT 
        shipper_code,
        report_month,
        AVG(estimated_pct) as current_val
    FROM public.v_parr_industry
    GROUP BY shipper_code, report_month
),
MoMCalculation AS (
    -- On récupère la valeur du mois précédent avec LAG
    SELECT 
        shipper_code,
        report_month,
        current_val,
        LAG(current_val) OVER (PARTITION BY shipper_code ORDER BY report_month) as prev_val
    FROM MonthlyAverages
)
-- On fait le calcul final du pourcentage de changement
SELECT 
    shipper_code,
    report_month,
    current_val,
    prev_val,
    CASE 
        WHEN prev_val = 0 OR prev_val IS NULL THEN NULL 
        ELSE ((current_val - prev_val) / prev_val) * 100 
    END as mom_change_pct
FROM MoMCalculation
ORDER BY report_month DESC, shipper_code;</CommandText>
      </Query>
      <Fields>
        <Field Name="shipper_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>shipper_code</DataField>
        </Field>
        <Field Name="report_month">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>report_month</DataField>
        </Field>
        <Field Name="current_val">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>current_val</DataField>
        </Field>
        <Field Name="prev_val">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>prev_val</DataField>
        </Field>
        <Field Name="mom_change_pct">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>mom_change_pct</DataField>
        </Field>
      </Fields>
    </DataSet>
