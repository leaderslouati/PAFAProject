    <DataSet Name="ComplianceRate">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 
    -- Vos colonnes de regroupement (à adapter selon vos besoins)
    report_month, 
    shipper_code,
    
    -- L'équivalent de votre mesure [Compliance Rate]
    CAST(COUNT(*) FILTER (WHERE is_compliant = 1) AS NUMERIC) 
    / NULLIF(COUNT(*), 0) AS compliance_rate

FROM public.v_parr_industry
GROUP BY 
    report_month, 
    shipper_code;</CommandText>
      </Query>
      <Fields>
        <Field Name="report_month">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>report_month</DataField>
        </Field>
        <Field Name="shipper_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>shipper_code</DataField>
        </Field>
        <Field Name="compliance_rate">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>compliance_rate</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="MoM_Change">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH MoyenneMensuelle AS (
    SELECT 
        report_month,
        shipper_code,
        AVG(estimated_pct) AS current_val
    FROM public.v_parr_industry
    GROUP BY report_month, shipper_code
),
ValeurPrecedente AS (
    SELECT 
        report_month,
        shipper_code,
        current_val,
        -- Récupère la valeur du mois précédent chronologiquement
        LAG(current_val) OVER (PARTITION BY shipper_code ORDER BY report_month) AS prev_val
    FROM MoyenneMensuelle
)
SELECT 
    report_month,
    shipper_code,
    CASE 
        WHEN prev_val = 0 OR prev_val IS NULL THEN NULL 
        ELSE ((current_val - prev_val) / prev_val) * 100 
    END AS "MoM Change %"
FROM ValeurPrecedente;</CommandText>
      </Query>
      <Fields>
        <Field Name="report_month">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>report_month</DataField>
        </Field>
        <Field Name="shipper_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>shipper_code</DataField>
        </Field>
        <Field Name="MoM_Change__">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>MoM Change %</DataField>
        </Field>
      </Fields>
    </DataSet>
