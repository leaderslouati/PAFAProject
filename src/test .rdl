    <DataSet Name="DS_Estimated_Evolution">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 
    CAST(report_month || '-01' AS DATE) AS report_month,
    product_class, -- Colonne identifiant PC1 ou PC2
    AVG(estimated_pct) / 100.0 AS estimated_reads_pct
FROM public.v_parr_industry
WHERE product_class IN ('PC1', 'PC2')
GROUP BY report_month, product_class
ORDER BY report_month ASC;</CommandText>
      </Query>
      <Fields>
        <Field Name="report_month">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>report_month</DataField>
        </Field>
        <Field Name="product_class">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>product_class</DataField>
        </Field>
        <Field Name="estimated_reads_pct">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>estimated_reads_pct</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_CheckReads_Count">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 
    CAST(report_month || '-01' AS DATE) AS report_month,
    product_class, 
    COUNT(*) AS count_check_reads
FROM public.v_parr_industry
WHERE is_compliant = 0 -- Filtre les relevés non conformes / non fournis
AND product_class IN ('PC1', 'PC2')
GROUP BY report_month, product_class
ORDER BY report_month ASC;</CommandText>
      </Query>
      <Fields>
        <Field Name="report_month">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>report_month</DataField>
        </Field>
        <Field Name="product_class">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>product_class</DataField>
        </Field>
        <Field Name="count_check_reads">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>count_check_reads</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_Industry_KPIs">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH MonthlyData AS (
    SELECT 
        report_month,
        AVG(estimated_pct) / 100.0 AS avg_val
    FROM public.v_parr_industry
    GROUP BY report_month
),
Changes AS (
    SELECT 
        report_month,
        avg_val as current_val,
        LAG(avg_val, 1) OVER (ORDER BY report_month) as prev_month_val,
        LAG(avg_val, 12) OVER (ORDER BY report_month) as prev_year_val
    FROM MonthlyData
)
SELECT 
    (current_val - prev_month_val) * 100 as monthly_change,
    (current_val - prev_year_val) * 100 as annual_change
FROM Changes
ORDER BY report_month DESC
LIMIT 1; -- On ne garde que le dernier mois connu</CommandText>
      </Query>
      <Fields>
        <Field Name="monthly_change">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>monthly_change</DataField>
        </Field>
        <Field Name="annual_change">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>annual_change</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_Shipper_Ranking">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH MoM AS (
    SELECT 
        shipper_code,
        report_month,
        AVG(estimated_pct) / 100.0 as current_val,
        LAG(AVG(estimated_pct) / 100.0) OVER (PARTITION BY shipper_code ORDER BY report_month) as prev_val
    FROM public.v_parr_industry
    GROUP BY shipper_code, report_month
)
SELECT 
    shipper_code,
    (current_val - prev_val) * 100 as change_pct
FROM MoM
WHERE report_month = (SELECT MAX(report_month) FROM public.v_parr_industry)
ORDER BY ABS((current_val - prev_val) * 100) DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="shipper_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>shipper_code</DataField>
        </Field>
        <Field Name="change_pct">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>change_pct</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_KPI_PC1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH MonthlyData AS (
    SELECT report_month, AVG(estimated_pct)/100.0 AS avg_val
    FROM public.v_parr_industry 
    WHERE product_class = 'PC1'
    GROUP BY report_month
),
Changes AS (
    SELECT report_month,
           (avg_val - LAG(avg_val, 1) OVER (ORDER BY report_month)) * 100 as monthly_change,
           (avg_val - LAG(avg_val, 12) OVER (ORDER BY report_month)) * 100 as annual_change
    FROM MonthlyData
)
SELECT monthly_change, annual_change FROM Changes
ORDER BY report_month DESC LIMIT 1;</CommandText>
      </Query>
      <Fields>
        <Field Name="monthly_change">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>monthly_change</DataField>
        </Field>
        <Field Name="annual_change">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>annual_change</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_Top_PC1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH MoM AS (
    SELECT shipper_code, report_month,
           (AVG(estimated_pct)/100.0) as current_val,
           LAG(AVG(estimated_pct)/100.0) OVER (PARTITION BY shipper_code ORDER BY report_month) as prev_val
    FROM public.v_parr_industry 
    WHERE product_class = 'PC1'
    GROUP BY shipper_code, report_month
)
SELECT shipper_code, (current_val - prev_val) * 100 as change_pct
FROM MoM
WHERE report_month = (SELECT MAX(report_month) FROM public.v_parr_industry)
AND (current_val - prev_val) &lt; 0
ORDER BY change_pct ASC LIMIT 3;</CommandText>
      </Query>
      <Fields>
        <Field Name="shipper_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>shipper_code</DataField>
        </Field>
        <Field Name="change_pct">
