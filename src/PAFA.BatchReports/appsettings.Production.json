{
  "ConnectionStrings": {
    "DefaultConnection": "Host=db;Port=5432;Database=pafadb;Username=postgres;Password=postgres"
  },
  "Sftp": {
    "Host": "pafa_sftp",
    "Port": 22,
    "RemotePath": "/upload",
    "ProcessedPath": "/processed",
    "FailedPath": "/failed",
    "FilePattern": "*.xlsx"
  },
  "BlobStorage": {
    "Provider": "MinIO",
    "Endpoint": "pafa_minio:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UseSsl": false
  },
  "BatchReports": {
    "OutputDirectory": "/app/output/reports",
    "TempDirectory": "/app/output/reports/temp",
    "MaxRetryAttempts": 3
  }
}
